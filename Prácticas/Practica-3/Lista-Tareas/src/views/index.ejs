<%- include('layout', { title: 'Lista de Tareas' , body: ` <a class="btn" href="/tasks/new">Nueva tarea</a>
    <div class="card">
        <table>
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Estado</th>
                    <th>Creada</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                ${tasks.length === 0
                ? `<tr>
                    <td colspan="4">No hay tareas</td>
                </tr>`
                : tasks.map(t => `
                <tr>
                    <td>${t.title}</td>
                    <td>${t.status}</td>
                    <td>${new Date(t.createdAt).toLocaleString('es-BO')}</td>
                    <td style="display:flex; gap:8px;">
                        <a class="btn" href="/tasks/${t._id}/edit">Editar</a>
                        <form action="/tasks/${t._id}/delete" method="POST" onsubmit="return confirm('¿Eliminar?')">
                            <button class="btn btn-danger" type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
                `).join('')}
            </tbody>
        </table>
    </div>
    `
    }) %>